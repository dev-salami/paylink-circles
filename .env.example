# PayLink Circles (Nimiq mini app). Copy to .env.local. Defaults use real money.

# NIM network for new groups: mainnet (default). Only exact "testnet" selects testnet.
# For local testing, explicitly set NIMIQ_NETWORK=testnet and use a testnet wallet.
# Existing groups keep the network stored on them.
# Must match Nimiq Pay's NIM network. This does not move USDT off Polygon.
NIMIQ_NETWORK=mainnet
# Optional custom Albatross JSON-RPC. Applies only to the network selected above.
# NIMIQ_RPC_URL=

# USDT chain for groups created from now on.
# polygon: official USDT 0xc2132D05D31c914a87C6611C10748AEb04B58e8F. USDT_TOKEN_ADDRESS is ignored.
# sepolia: testing only, and it needs USDT_TOKEN_ADDRESS.
USDT_CHAIN=polygon
# USDT_RPC_URL applies only to the chain selected above.
# USDT_TOKEN_ADDRESS=

# Public URL used in reminder links.
APP_URL=http://localhost:3020
# Where the JSON store lives (mount a volume here in production).
# DATA_DIR=/data

# Optional email reminders via Resend.
# RESEND_API_KEY=
# RESEND_FROM="PayLink Circles <circles@example.com>"
